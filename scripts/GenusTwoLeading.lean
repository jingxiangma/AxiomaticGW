module

public import AxiomaticGW.Surfaces.GenusTwoLeadingTerms

/-!
# Native leading-coefficient diagnostic

Generated by `scripts/export_genus_two_leading.py`. Native values are search data.
-/

@[expose] public section
set_option maxRecDepth 20000

namespace AxiomaticGW.GenusTwoLeadingExport
open Lean

/-- Version-one state codes: unit, hyperplane, point, then exceptional divisors. -/
def labelCode {X : SurfaceTarget} : SurfaceBasisLabel X → ℕ
  | .unit => 0
  | .hyperplane => 1
  | .point => 2
  | .exceptional i => 3 + i.val

/-- A full ancestor request with stable, permutation-independent insertion order. -/
def queryJSON {X : SurfaceTarget} (q : SurfaceAncestorKey X) : Json :=
  Json.mkObj [("genus", toJson q.genus),
    ("curve", toJson ((List.finRange (X.blowups + 1)).map q.beta)),
    ("insertions", toJson ((q.insertions.map fun i ↦
      [labelCode i.label, i.psi]).sort (· ≤ ·)))]

/-- Preserve exact rational numerators and denominators. -/
def ratJSON (q : ℚ) : Json := toJson [q.num, (q.den : ℤ)]

/-- Uncollected monomials retain every coefficient and repeated variable. -/
def termsJSON {X : SurfaceTarget} (p : RationalTerms (SurfaceAncestorKey X)) : String :=
  let terms := (p.map fun t ↦
    "{\"coefficient\":" ++ (ratJSON t.1).compress ++ ",\"monomial\":[" ++
      String.intercalate "," ((t.2.map (fun q ↦ (queryJSON q).compress)).sort (· ≤ ·)) ++ "]}"
    ).sort (· ≤ ·)
  "[" ++ String.intercalate "," terms ++ "]"

/-- Dimension filtering only: all genus-zero/one variables remain visible here. -/
def symbolicVertex (X : SurfaceTarget) :
    SurfaceVertexValues X (RationalTerms (SurfaceAncestorKey X)) :=
  fun g S _ h beta k a ↦
    let q := SurfaceAncestorKey.ofLabels g S h beta k a
    if q.DimensionCompatible then RationalTerms.term 1 {q} else 0



/-- Every canonical primary/first-descendant column, including absent variables. -/
def canonicalColumns (X : SurfaceTarget) (beta : X.Curve) : List (SurfaceQuery X) :=
  let e := X.effective.energy beta
  let divisors : List (SurfaceBasisLabel X) :=
    .hyperplane :: (List.finRange X.blowups).map .exceptional
  SurfaceQuery.points X 2 beta (e + 1) ::
    divisors.map (fun b ↦ SurfaceFirstDescendant.query 2 beta b e) ++
    if e = 0 then [] else [SurfaceFirstDescendant.query 2 beta .point (e - 1)]

def columnJSON {X : SurfaceTarget} (q : SurfaceQuery X) : Json :=
  Json.mkObj [("genus", toJson q.genus),
    ("curve", toJson ((List.finRange (X.blowups + 1)).map q.beta)),
    ("insertions", toJson ((q.insertions.map fun i ↦
      [labelCode i.label, i.psi]).mergeSort (· ≤ ·)))]

def caseJSON (family name : String) (X : SurfaceTarget) (beta : X.Curve) (n : ℕ)
    {m : ℕ} (a : Fin m → SurfaceBasisLabel X)
    (entry : SurfacePolynomialReduction.Variable X → ℚ) : Json :=
  let columns := canonicalColumns X beta
  Json.mkObj [("family", toJson family), ("name", toJson name),
    ("blowups", toJson X.blowups),
    ("curve", toJson ((List.finRange (X.blowups + 1)).map beta)),
    ("additional_markings", toJson n),
    ("labels", toJson ((List.finRange m).map (fun i ↦ labelCode (a i)))),
    ("columns", toJson (columns.map columnJSON)),
    ("coefficients", toJson (columns.map fun q ↦ ratJSON (entry (.inr q))))]

def bpCase (name : String) (X : SurfaceTarget) (beta : X.Curve) (n : ℕ)
    (a : Fin 3 → SurfaceBasisLabel X) : Json :=
  caseJSON "BP" name X beta n a
    (BelorousskiPandharipande.leadingCoefficient X n beta 0 (SurfaceGenusZero.pointLabels a n))

def l24Case (name : String) (X : SurfaceTarget) (beta : X.Curve) (n : ℕ)
    (a : Fin 4 → SurfaceBasisLabel X) : Json :=
  caseJSON "L24" name X beta n a
    (L24Relation.leadingCoefficient X n beta 0 (SurfaceGenusZero.pointLabels a n))

end AxiomaticGW.GenusTwoLeadingExport
open AxiomaticGW GenusTwoLeadingExport Lean

def main (args : List String) : IO Unit := do
  let jobs : List (String × (Unit → Json)) := [
    ("p2_zero_HH1", fun _ ↦
      bpCase "p2_zero_HH1" .plane ![0] 0
        ![.hyperplane, .hyperplane, .unit]),
    ("p2_line_HHH", fun _ ↦
      bpCase "p2_line_HHH" .plane ![1] 2
        ![.hyperplane, .hyperplane, .hyperplane]),
    ("f1_E_EEE", fun _ ↦
      bpCase "f1_E_EEE" .hirzebruchOne ![1,0] 0
        ![.exceptional 0, .exceptional 0, .exceptional 0]),
    ("f1_F_HHH", fun _ ↦
      bpCase "f1_F_HHH" .hirzebruchOne ![0,1] 1
        ![.hyperplane, .hyperplane, .hyperplane]),
    ("f1_F_EHH", fun _ ↦
      bpCase "f1_F_EHH" .hirzebruchOne ![0,1] 1
        ![.exceptional 0, .hyperplane, .hyperplane]),
    ("bl2_E1_E1E1E1", fun _ ↦
      bpCase "bl2_E1_E1E1E1" .blowupTwo ![1,0,0] 0
        ![.exceptional 0, .exceptional 0, .exceptional 0]),
    ("bl2_E2_E1E1E1", fun _ ↦
      bpCase "bl2_E2_E1E1E1" .blowupTwo ![0,1,0] 0
        ![.exceptional 0, .exceptional 0, .exceptional 0]),
    ("bl2_E2_E2E2E2", fun _ ↦
      bpCase "bl2_E2_E2E2E2" .blowupTwo ![0,1,0] 0
        ![.exceptional 1, .exceptional 1, .exceptional 1]),
    ("bl2_L_HHH", fun _ ↦
      bpCase "bl2_L_HHH" .blowupTwo ![0,0,1] 0
        ![.hyperplane, .hyperplane, .hyperplane]),
    ("bl2_L_E1E2H", fun _ ↦
      bpCase "bl2_L_E1E2H" .blowupTwo ![0,0,1] 0
        ![.exceptional 0, .exceptional 1, .hyperplane]),
    ("p2_zero_HH11", fun _ ↦
      l24Case "p2_zero_HH11" .plane ![0] 0
        ![.hyperplane, .hyperplane, .unit, .unit]),
    ("p2_line_HHHP", fun _ ↦
      l24Case "p2_line_HHHP" .plane ![1] 0
        ![.hyperplane, .hyperplane, .hyperplane, .point]),
    ("p2_line_HHHH_p", fun _ ↦
      l24Case "p2_line_HHHH_p" .plane ![1] 1
        ![.hyperplane, .hyperplane, .hyperplane, .hyperplane]),
    ("f1_E_EEE1", fun _ ↦
      l24Case "f1_E_EEE1" .hirzebruchOne ![1,0] 0
        ![.exceptional 0, .exceptional 0, .exceptional 0, .unit]),
    ("f1_F_EHHH", fun _ ↦
      l24Case "f1_F_EHHH" .hirzebruchOne ![0,1] 0
        ![.exceptional 0, .hyperplane, .hyperplane, .hyperplane]),
    ("bl2_E1_E1E1E11", fun _ ↦
      l24Case "bl2_E1_E1E1E11" .blowupTwo ![1,0,0] 0
        ![.exceptional 0, .exceptional 0, .exceptional 0, .unit]),
    ("bl2_E2_E1E1E11", fun _ ↦
      l24Case "bl2_E2_E1E1E11" .blowupTwo ![0,1,0] 0
        ![.exceptional 0, .exceptional 0, .exceptional 0, .unit]),
    ("bl2_L_E1E2H1", fun _ ↦
      l24Case "bl2_L_E1E2H1" .blowupTwo ![0,0,1] 0
        ![.exceptional 0, .exceptional 1, .hyperplane, .unit]),
    ("bl2_E1E2_E1E1E2E2", fun _ ↦
      l24Case "bl2_E1E2_E1E1E2E2" .blowupTwo ![1,1,0] 0
        ![.exceptional 0, .exceptional 0, .exceptional 1, .exceptional 1]),
    ("p2_line_HHP", fun _ ↦
      bpCase "p2_line_HHP" .plane ![1] 1
        ![.hyperplane, .hyperplane, .point]),
    ("p2_line_HPP", fun _ ↦
      bpCase "p2_line_HPP" .plane ![1] 0
        ![.hyperplane, .point, .point]),
    ("f1_F_HHP", fun _ ↦
      bpCase "f1_F_HHP" .hirzebruchOne ![0,1] 0
        ![.hyperplane, .hyperplane, .point]),
    ("f1_F_EHP", fun _ ↦
      bpCase "f1_F_EHP" .hirzebruchOne ![0,1] 0
        ![.exceptional 0, .hyperplane, .point]),
    ("bl2_E1E2_HHP", fun _ ↦
      bpCase "bl2_E1E2_HHP" .blowupTwo ![1,1,0] 0
        ![.hyperplane, .hyperplane, .point]),
    ("bl2_E1E2_E1E2P", fun _ ↦
      bpCase "bl2_E1E2_E1E2P" .blowupTwo ![1,1,0] 0
        ![.exceptional 0, .exceptional 1, .point])]
  let stderr ← IO.getStderr
  let mut cases := []
  for (name, run) in jobs do
    if args.isEmpty || args.contains name then
      stderr.putStrLn s!"Leading matrix: {name}"
      cases := cases ++ [run ()]
  IO.println (Json.mkObj [("schema_version", toJson (1 : ℕ)),
    ("cases", toJson cases)]).compress
