        Matrix.of_apply, SurfaceFrames.Plane.request]
    all_goals norm_num only [tables,
      values,
      numerators,
      denominators,
      SurfaceFrames.Plane.request,
      Matrix.cons_val,
      Matrix.of_apply,
      Matrix.cons_val_zero',
