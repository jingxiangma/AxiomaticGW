/-!
# Kernel replay of full GKM curve and invariant-edge conventions

Generated by scripts/export_gkm_curve_certificate.py from exact candidate data.
The fan requests and surface coordinate semantics are independently fixed.
Closed finite checks use kernel-checked decide; symbolic identities use field arithmetic.
No geometric localization, CohFT class, or numerical GW invariant is claimed.
-/

@[expose] public section

namespace AxiomaticGW.GKM.CurveReplay

open CurveConventionCertificate EquivariantCoefficients
open Matrix

noncomputable section

namespace Plane

/-- Serialized fan, full lattice, wall, and oriented edge data. -/
def tables : Tables .plane 3 3 where
  rays := ![![1, 0], ![0, 1], ![-1, -1]]
  points := ![
    ![⟨0, by decide⟩, ⟨1, by decide⟩],
    ![⟨0, by decide⟩, ⟨2, by decide⟩],
    ![⟨1, by decide⟩, ⟨2, by decide⟩]]
  tangent := ![![![0, 1], ![1, 0]], ![![1, -1], ![0, -1]], ![![-1, 0], ![-1, 1]]]
  curveMatrix := !![
    1]
  weights := ![3]
  wallClasses := ![![1], ![1], ![1]]
  intersections := ![![1, 1, 1]]
  edges := ![
    { source := ⟨0, by decide⟩,
      target := ⟨1, by decide⟩,
      wall := ⟨0, by decide⟩,
      weight := ![0, 1],
      curve := ![1],
      normalSource := ⟨2, by decide⟩,
      normalTarget := ⟨2, by decide⟩,
      normalDegree := 1 },
    { source := ⟨0, by decide⟩,
      target := ⟨2, by decide⟩,
      wall := ⟨1, by decide⟩,
      weight := ![1, 0],
      curve := ![1],
      normalSource := ⟨1, by decide⟩,
      normalTarget := ⟨1, by decide⟩,
      normalDegree := 1 },
    { source := ⟨1, by decide⟩,
      target := ⟨2, by decide⟩,
      wall := ⟨2, by decide⟩,
      weight := ![1, -1],
      curve := ![1],
      normalSource := ⟨0, by decide⟩,
      normalTarget := ⟨0, by decide⟩,
      normalDegree := 1 }]

set_option maxHeartbeats 2000000 in
-- Replay checks finite fan adjacency and every symbolic divisor intersection.
/-- Kernel acceptance against the independently held fan and surface API. -/
theorem accepted : Accepts CurveFrames.Plane.request tables where
  rays_eq := by decide
  points_eq := by decide
  tangent_eq := by decide
  matrix_eq := by decide
  weights_eq := by decide
  walls_eq := by decide
  generators_eq := by decide
  tangent_dual := by decide
  state_euler := by
    intro p
    fin_cases p
    all_goals dsimp only [CurveFrames.Plane.request,
      SurfaceFrames.Plane.request,
      character,
      Matrix.cons_val]
    all_goals norm_num only [Matrix.cons_val,
      Matrix.of_apply,
      Matrix.cons_val_zero',
      Matrix.cons_val_succ',
      Matrix.cons_val_zero,
      Matrix.cons_val_succ,
      Matrix.cons_val_fin_one,
      Matrix.cons_val_one,
      Fin.mk.injEq,
      Fin.ext_iff,
      Fin.val_succ,
      Fin.val_zero,
      Fin.val_natCast,
      Fin.val_one',
      ite_true,
      ite_false,
      Fin.coe_ofNat_eq_mod,
      Fin.val_ofNat,
      one_mul,
      mul_one,
      zero_mul,
      mul_zero,
      zero_add,
      add_zero,
      div_one,
      pow_zero,
      pow_one,
      neg_one_mul,
      neg_zero,
      sub_zero,
      zero_sub,
      sub_self]
    all_goals ring
  state_tangentSum := by
    intro p
    fin_cases p
    all_goals dsimp only [CurveFrames.Plane.request,
      SurfaceFrames.Plane.request,
      character,
      Matrix.cons_val]
    all_goals norm_num only [Matrix.cons_val,
      Matrix.of_apply,
      Matrix.cons_val_zero',
      Matrix.cons_val_succ',
      Matrix.cons_val_zero,
      Matrix.cons_val_succ,
      Matrix.cons_val_fin_one,
      Matrix.cons_val_one,
      Fin.mk.injEq,
      Fin.ext_iff,
      Fin.val_succ,
      Fin.val_zero,
      Fin.val_natCast,
      Fin.val_one',
      ite_true,
      ite_false,
      Fin.coe_ofNat_eq_mod,
      Fin.val_ofNat,
      one_mul,
      mul_one,
      zero_mul,
      mul_zero,
      zero_add,
      add_zero,
      div_one,
      pow_zero,
      pow_one,
      neg_one_mul,
      neg_zero,
      sub_zero,
      zero_sub,
      sub_self]
    all_goals ring
  intersections_eq := by decide
  intersections_trace := by
    intro i rho
    fin_cases i
    all_goals fin_cases rho
    all_goals dsimp only [tables,
      CurveFrames.Plane.request,
      SurfaceFrames.Plane.request,
      divisorRestriction,
      character,
      Matrix.cons_val]
    all_goals norm_num only [tables,
      CurveFrames.Plane.request,
      SurfaceFrames.Plane.request,
      divisorRestriction,
      character,
      Fin.sum_univ_succ,
      Fintype.sum_empty,
      Matrix.cons_val,
      Matrix.of_apply,
      Matrix.cons_val_zero',
      Matrix.cons_val_succ',
      Matrix.cons_val_zero,
      Matrix.cons_val_succ,
      Matrix.cons_val_fin_one,
      Matrix.cons_val_one,
      Fin.mk.injEq,
      Fin.ext_iff,
      Fin.val_succ,
      Fin.val_zero,
      Fin.val_natCast,
      Fin.val_one',
      ite_true,
      ite_false,
      Fin.coe_ofNat_eq_mod,
      Fin.val_ofNat,
      one_mul,
      mul_one,
      zero_mul,
      mul_zero,
      zero_add,
      add_zero,
      div_one,
      pow_zero,
      pow_one,
      neg_one_mul,
      neg_zero,
      sub_zero,
      zero_sub,
      sub_self]
    all_goals field_simp [x_ne_zero, y_ne_zero, x_sub_y_ne_zero, y_sub_x_ne_zero]
    all_goals ring
  walls_bijective := by decide
  edge_endpoints := by
    simp only [Incident]
    decide
  edges_complete := by
    simp only [Adjacent, Incident]
    decide
  edge_classes := by decide
  source_weights := by decide
  target_weights := by decide
  normal_branches := by
    simp only [Adjacent, Incident]
    decide
  normal_energy := by decide
  normal_characters := by decide

end Plane

