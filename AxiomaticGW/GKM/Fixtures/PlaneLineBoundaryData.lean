module

public import AxiomaticGW.GKM.EquivariantCoefficients
public import Mathlib.Data.Fin.VecNotation

/-!
# Fixed-locus data for a degree-one line in the plane

Generated by `scripts/gkm_plane_line_boundary_class.py` from the pinned producer.
All three surviving loci share their edge, two vertex, insertion and stabilizer factors.
-/

@[expose] public section
namespace AxiomaticGW.GKM.PlaneLineBoundaryData
open EquivariantCoefficients

noncomputable section

/-- Contracted endpoint of each external marking, in request order. -/
def baseLeg : Fin 4 → Fin 2 := ![0, 0, 1, 1]

/-- Contracted endpoint of each external marking, in request order. -/
def leftLeg : Fin 5 → Fin 2 := ![0, 0, 1, 1, 0]

/-- Contracted endpoint of each external marking, in request order. -/
def rightLeg : Fin 5 → Fin 2 := ![0, 0, 1, 1, 1]

/-- Native three-point tail at degree 0, in unit, H, pt order. -/
def tail0 : Fin 3 → ℚ := ![1, 0, 0]

/-- Native three-point tail at degree 1, in unit, H, pt order. -/
def tail1 : Fin 3 → ℚ := ![0, 0, 0]

/-- Exact incoming edge coefficient. -/
def edge : Coefficient :=
  ((-1) / (((x ^ 2) * (y ^ 2)) - (x * (y ^ 3))))

/-- Exact incoming tangent coefficient. -/
def tangent : Coefficient :=
  (((-(x ^ 2)) * (y ^ 2)) + (x * (y ^ 3)))

/-- Exact incoming insertions coefficient. -/
def insertions : Coefficient :=
  (((x ^ 2) * (y ^ 4)) - (x * (y ^ 5)))

/-- Exact incoming eulerLeft coefficient. -/
def eulerLeft : Coefficient :=
  (x * y)

/-- Exact incoming eulerRight coefficient. -/
def eulerRight : Coefficient :=
  (((-x) * y) + (y ^ 2))

/-- Exact incoming flagLeft coefficient. -/
def flagLeft : Coefficient :=
  y

/-- Exact incoming flagRight coefficient. -/
def flagRight : Coefficient :=
  (-y)

/-- Exact incoming automorphism coefficient. -/
def automorphism : Coefficient :=
  1

/-- Exact incoming baseClaim coefficient. -/
def baseClaim : Coefficient :=
  1

/-- Exact incoming psiLeft coefficient. -/
def psiLeft : Coefficient :=
  (1 / y)

/-- Exact incoming psiRight coefficient. -/
def psiRight : Coefficient :=
  (1 / (-y))

end

end AxiomaticGW.GKM.PlaneLineBoundaryData
