    fraction i = (constants i : Coefficient) := by
  apply (div_eq_iff (embed_ne_zero_of_atZero _ (regular i))).mpr
  fin_cases i
  norm_num [numerators, denominators, constants, map_add, map_mul, map_pow, embed_C]

