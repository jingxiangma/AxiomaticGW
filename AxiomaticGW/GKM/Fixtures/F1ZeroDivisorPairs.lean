  norm_num [numerators, denominators, constants, atZero, map_zero, map_one, map_add, map_mul,
    map_pow, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X', RingHom.id_apply, Pi.zero_apply]

