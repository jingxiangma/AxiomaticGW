  | 1, 2, 3, 1 => (1 : R)
  | 1, 3, 1, 2 => (1 : R)
  | 1, 3, 2, 1 => (1 : R)
  | 1, 1, 3, 3 => (-1 : R) * v + (1 : R) * u
  | 1, 3, 1, 3 => (-1 : R) * v + (1 : R) * u
  | 1, 3, 3, 1 => (-1 : R) * v + (1 : R) * u
  | 1, 2, 2, 3 => (1 : R)
  | 1, 2, 3, 2 => (1 : R)
