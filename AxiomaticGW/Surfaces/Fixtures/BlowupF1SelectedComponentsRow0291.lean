  (![
    22, 38, 43, 48, 97, 111, 113, 152, 153, 166, 167, 170, 179, 180, 183, 244, 257, 261, 273, 278, 283, 288, 358, 373, 375, 388, 390, 394, 431, 443, 458, 459, 469, 473, 542, 561, 641, 651, 653, 666, 668
  ] : Fin 41 → Fin 722) i

