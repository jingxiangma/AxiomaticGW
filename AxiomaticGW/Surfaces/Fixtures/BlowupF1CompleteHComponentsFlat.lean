/-- The complete original table, traversed directly in its original order. -/
def directValues : Multiset (SurfaceAncestorKey X × RationalTerms (SurfaceAncestorKey X)) :=
  ↑((keyList.zip valueList).map fun t ↦
    (t.1, (RationalTerms.term t.2 0 : RationalTerms (SurfaceAncestorKey X))))

theorem keyList_length : keyList.length = 722 := rfl

theorem valueList_length : valueList.length = 722 := rfl

set_option maxHeartbeats 0 in
/-- Pointwise list/array conversion binds every key and value without evaluating ancestors. -/
theorem directList_eq_ofFn :
    (keyList.zip valueList).map (fun t ↦ (t.1, RationalTerms.term t.2 0)) =
      List.ofFn (fun i : Fin 722 ↦ (key i, entries i)) := by
  apply List.ext_getElem
  · simp only [List.length_map, List.length_zip, keyList_length, valueList_length,
      Nat.min_self, List.length_ofFn]
  · intro i hi₁ hi₂
    simp only [List.getElem_map, List.getElem_zip, List.getElem_ofFn]
    rfl

set_option maxHeartbeats 0 in
/-- Only the representation changes; all original stored expressions are identical. -/
theorem directValues_eq : directValues = BlowupF1CompleteHComponents.cache.values := by
  change ↑((keyList.zip valueList).map
      (fun t ↦ (t.1, (RationalTerms.term t.2 0 : RationalTerms (SurfaceAncestorKey X))))) =
    Finset.univ.val.map (fun i : Fin 722 ↦ (key i, entries i))
  rw [Fin.univ_val_map]
  exact congrArg (fun l : List (SurfaceAncestorKey X × RationalTerms (SurfaceAncestorKey X)) ↦
    (↑l : Multiset (SurfaceAncestorKey X × RationalTerms (SurfaceAncestorKey X))))
    directList_eq_ofFn

/-- The same certified cache specification, using direct list storage. -/
def cache : ResidualCache X where
  queries := BlowupF1CompleteHComponents.cache.queries
  values := directValues
  values_eq := directValues_eq.trans BlowupF1CompleteHComponents.cache.values_eq

private theorem replace_values_eq (c : ResidualCache X)
    (v : Multiset (SurfaceAncestorKey X × RationalTerms (SurfaceAncestorKey X)))
    (h : v = c.values) :
    (⟨c.queries, v, h.trans c.values_eq⟩ : ResidualCache X) = c := by
  cases c with
  | mk queries values values_eq =>
    cases h
    rfl

theorem cache_eq : cache = BlowupF1CompleteHComponents.cache :=
  replace_values_eq _ _ directValues_eq

theorem queries_eq : cache.queries = BlowupF1CompleteHComponents.cache.queries := rfl

theorem lookup_eq (q : SurfaceAncestorKey X) :
    cache.lookup? q = BlowupF1CompleteHComponents.cache.lookup? q := by
  rw [cache_eq]

end AxiomaticGW.BlowupF1CompleteHComponentsFlat
