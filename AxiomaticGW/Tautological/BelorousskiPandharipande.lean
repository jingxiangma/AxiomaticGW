/-- Pushforward kappa_(1,1) equals kappa_1 squared plus kappa_2. -/
def toMonomial (x : Coordinates 100) (i : Fin 100) : ℚ :=
  x i + if i = 0 then x 1 else 0

/-- The inverse subtracts kappa_2 in the same smooth-vertex coordinate. -/
def toPushforward (x : Coordinates 100) (i : Fin 100) : ℚ :=
  x i - if i = 0 then x 1 else 0

/-- The coordinate conventions are inverse for arbitrary rational coefficients. -/
theorem conversion_inverse (x : Coordinates 100) :
    toPushforward (toMonomial x) = x ∧ toMonomial (toPushforward x) = x := by
  constructor <;> funext i <;> by_cases h : i = 0
  · subst i
    simp only [toPushforward, toMonomial, if_true, show (1 : Fin 100) ≠ 0 by decide,
      if_false, add_zero, add_sub_cancel_right]
  · simp only [toPushforward, toMonomial, h, if_false, add_zero, sub_zero]
  · subst i
    simp only [toPushforward, toMonomial, if_true, show (1 : Fin 100) ≠ 0 by decide,
      if_false, sub_zero, sub_add_cancel]
  · simp only [toPushforward, toMonomial, h, if_false, add_zero, sub_zero]

/-- Each held unsymmetrized row is exactly its original source row after conversion. -/
theorem rows_conversion : ∀ i, toMonomial (originalRows i) = unsymmetrizedRows i := by
  decide +kernel

