/-- The symmetry operation is bound to actual column relabellings. -/
theorem rows_symmetrized : ∀ i, rows i = symmetrize (unsymmetrizedRows i) := by
  decide +kernel

/-- Exact coefficients in the twenty held symmetrized rows. -/
def certificate : Certificate 20 := ⟨![(1 / 103680), (-7 / 103680), (7 / 34560), (-7 / 20736), (-1
  / 180), (109 / 945), (-13 / 210), (-25 / 126), (-11 / 360), (-7 / 2160), (1 / 216), (1 / 270),
  (1 / 90), (-1 / 27), (1 / 40), (1 / 120), (-1 / 12), (-1 / 36), (-1 / 30), (1 / 6)]⟩

/-- Lean's kernel checks every coefficient of the complete published equation. -/
theorem checked : check rows requested certificate = true := by decide +kernel

/-- Every boundary row retains its complete original source coordinate vector. -/
theorem boundary_row_coordinates (i : Fin 16) : unsymmetrizedRows (Fin.natAdd 4 i) =
    combination (fun j ↦ Pi.single (sourceDestinations (sourceFamily i) j) 1)
      ⟨sourceRow i⟩ := by
  fin_cases i <;> decide +kernel

/-- Actual separating graph operations produce each boundary row in the certificate. -/
theorem boundary_row_gluing (i : Fin 16) :
    interpret columns (unsymmetrizedRows (Fin.natAdd 4 i)) =
      sourceMap (sourceFamily i) (sourceExpression i) := by
  rw [boundary_row_coordinates, sourceExpression, sourceMap_interpret]

/-- Incoming mathematical data; metadata hashes do not certify these equalities. -/
structure Exchange where
  /-- Raw columns, symmetric rows, held request and a candidate witness. -/
  presentation : Presentation 2 (Fin 3) 20 100
  /-- Original pushforward-kappa coordinates. -/
  originalRows : Fin 20 → Coordinates 100
  /-- Original monomial-kappa coordinates. -/
  unsymmetrizedRows : Fin 20 → Coordinates 100
  /-- The basis slot needing kappa conversion. -/
  conversionSource : Fin 100
  /-- The kappa_2 correction slot. -/
  conversionTarget : Fin 100
  /-- Source-to-monomial correction coefficient. -/
  forwardCoefficient : ℚ
  /-- Monomial-to-source correction coefficient. -/
  backwardCoefficient : ℚ
  /-- Decorated graph orders of all raw columns. -/
  automorphisms : Fin 100 → ℕ
  /-- Actual published representatives, prior to marking summation. -/
  paperColumns : Fin 20 → TautologicalStratum 2 (Fin 3)
  /-- Original published stack coefficients. -/
  paperCoefficients : Fin 20 → ℚ
  /-- Label-fixing graph orders for the published representatives. -/
  paperOrders : Fin 20 → ℕ
  /-- Published orbit slots before repeated assignments are combined. -/
  paperDestinations : Fin 20 → Fin 6 → Fin 100
  /-- Incoming sixfold action on every raw graph column. -/
  permutationDestinations : Fin 6 → Fin 100 → Fin 100
  /-- Actual source columns with every external marking and decoration. -/
  sourceColumns : (b : Fin 7) → Fin (sourceSize b) →
    TautologicalStratum (sourceGenus b) (Fin (sourceArity b))
  /-- Original component coefficient vectors. -/
  sourceRows : (i : Fin 16) → Coordinates (sourceSize (sourceFamily i))
  /-- Original component-to-target gluing slots. -/
  sourceDestinations : (b : Fin 7) → Fin (sourceSize b) → Fin 100
  /-- Original generator references, not indices of a reduced matrix. -/
  generatorReferences : Fin 20 → ℕ

/-- All incoming meanings are compared to the separately held mathematical claim. -/
def AcceptsExchange (p : Exchange) : Prop :=
  AcceptsPresentation columns rows requested p.presentation ∧
  p.originalRows = originalRows ∧ p.unsymmetrizedRows = unsymmetrizedRows ∧
  p.conversionSource = 1 ∧ p.conversionTarget = 0 ∧
  p.forwardCoefficient = 1 ∧ p.backwardCoefficient = -1 ∧
  p.automorphisms = automorphismOrders ∧ p.paperColumns = paperStratum ∧
  p.paperCoefficients = paperCoefficient ∧
  p.paperOrders = (fun i ↦ automorphismOrders (representative i)) ∧
  p.paperDestinations = (fun i e ↦ columnPermutation e (representative i)) ∧
  p.permutationDestinations = permutationDestinations ∧
  p.sourceColumns = sourceColumns ∧ p.sourceRows = sourceRow ∧
  p.sourceDestinations = sourceDestinations ∧ p.generatorReferences = generatorReferences

/-- Accepted arithmetic transfers only the explicitly supplied row vanishings. -/
theorem evaluated_relation {V : Type*} [AddCommGroup V] [Module ℚ V]
    (p : Exchange) (hp : AcceptsExchange p) (ev : StrataModule 2 (Fin 3) →ₗ[ℚ] V)
    (hrows : ∀ i, ev (interpret columns (rows i)) = 0) : ev paperRelation = 0 := by
  rw [← interpret_request]
  exact evaluation_eq_zero columns rows requested p.presentation.certificate
    ((check_eq_true_iff _ _ _).mpr hp.1.2) ev hrows

universe u
attribute [local instance] strataRealizationModule

/-- The full BP class relation follows from four original genus-two rows, sixteen
original component rows, and precisely the primitive graph operations used above. -/
theorem realized_relation_from_generators {R : Type u} [CommRing R] [Algebra ℚ R]
    {C : StableCurveCohomology R} {I : StableCurveIntegration C}
    (Z : ∀ g S, [Fintype S] → StrataRealization C g S) (F : SeparatingPushforward C I)
    (p : Exchange) (hp : AcceptsExchange p)
    (hl : ∀ e, (Z 2 (Fin 3)).RelabelCompatible (Z 2 (Fin 3))
      stableArity stableArity (labelPermutation e))
    (hc : ∀ b, SourceMapCompatible Z F b)
    (hinterior : ∀ i : Fin 4, (Z 2 (Fin 3)).map
      (interpret columns (unsymmetrizedRows (Fin.castAdd 16 i))) = 0)
    (hsource : ∀ i, (Z (sourceGenus (sourceFamily i)) (Fin (sourceArity (sourceFamily i)))).map
      (sourceExpression i) = 0) : (Z 2 (Fin 3)).map paperRelation = 0 := by
  have hu : ∀ i, (Z 2 (Fin 3)).map (interpret columns (unsymmetrizedRows i)) = 0 := by
    intro j
    refine Fin.addCases (m := 4) (n := 16) hinterior ?_ j
    intro i
    rw [boundary_row_gluing]
    exact sourceMap_vanishes Z F hc hl _ _ (hsource i)
  apply evaluated_relation p hp (Z 2 (Fin 3)).map
  intro i
  rw [rows_symmetrized, interpret_symmetrize, map_sum]
  apply Finset.sum_eq_zero
  intro e _
  rw [StrataRealization.map_relabel _ _ _ _ _ (hl e), hu, map_zero]

end AxiomaticGW.BelorousskiPandharipande
