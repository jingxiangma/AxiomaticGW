    "source": "/-\nCopyright (c) 2026 JMA. All rights reserved.\nReleased under Apache 2.0 license as described in the file LICENSE.\nAuthors: JMA\n-/\n\nimport AxiomaticGW.Surfaces.AncestorPolynomial\nimport AxiomaticGWTest.Tautological.GetzlerReplay\n\n/-!\n# Surface graph polynomial regressions\n\nThe rational callbacks below are algebraic probes of the expansion, not\nnumerical surface GW models. The final example consumes the actual frozen\ncertificate using the supplied theory's genuine component ancestors.\n-/\n\nset_option linter.privateModule false\n\nnamespace AxiomaticGWTest.Surfaces.AncestorPolynomial\n\nopen AxiomaticGW\n\ndef classicalCubic (X : SurfaceTarget) : SurfaceVertexValues X \u211a :=\n  fun g S _ _ beta k a \u21a6\n    if g = 0 \u2227 beta = 0 \u2227 Fintype.card S = 3 \u2227 (\u2200 s, k s = 0) then\n      SurfaceCohomology.counit X.blowups (\u220f s, (a s).value)\n    else 0\n\ndef ellipticPointProbe (X : SurfaceTarget) (beta\u2080 : X.Curve) (n : \u2115) :\n    SurfaceVertexValues X \u211a :=\n  fun g S _ h beta k a \u21a6\n    if g = 1 \u2227 beta = beta\u2080 \u2227 Fintype.card S = n \u2227 (\u2200 s, k s = 0 \u2227 a s = .point) then 1\n    else classicalCubic X g S h beta k a\n\ndef oneLoop : GluingExpression 1 (Fin 1) :=\n  GetzlerGraphs.close (.fundamental 0 (Fin 3) StableArity.zero_fin_three)\n\n\nend AxiomaticGWTest.Surfaces.AncestorPolynomial\nopen AxiomaticGW AxiomaticGWTest.Surfaces.AncestorPolynomial\n\ndef main : IO Unit := do\n  for target in [SurfaceTarget.plane, .hirzebruchOne, .blowupTwo] do\n    let started \u2190 IO.monoMsNow\n    let value := GetzlerGraphs.surfaceEquation target\n      (ellipticPointProbe target target.lineCurve 3) 1 target.lineCurve 0\n      (Option.elim \u00b7 .point (fun _ \u21a6 .hyperplane))\n    IO.println s!\"{repr target}: {value}; elapsed_ms={(\u2190 IO.monoMsNow) - started}\"\n    if value != -9 then throw (IO.userError \"wrong coefficient probe\")\n",
    "output": "AxiomaticGW.SurfaceTarget.plane: -9; elapsed_ms=0\nAxiomaticGW.SurfaceTarget.hirzebruchOne: -9; elapsed_ms=0\nAxiomaticGW.SurfaceTarget.blowupTwo: -9; elapsed_ms=0\n",
    "scope": "Execution evidence for the three line-class coefficient probes; no kernel proof or reliable timing claim."
  },
